<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren=false so the glow around the card isn't cut off by the scrim's bounds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickSearchScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quick_search_scrim"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="false">

    <!-- The card's shadow is drawn by this wrapper's background rather than by elevation: a
         translucent card shows the framework's shadow through itself as a hard rectangle. The
         12dp padding is the room those rings need, so the card's own edges still land 16dp from
         the screen. Top margin is set in code to a fraction of the screen height, so the card sits
         in the upper third with the app underneath still readable around it. -->
    <FrameLayout
        android:id="@+id/quickSearchCardGlow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_card_glow"
        android:clipChildren="false"
        android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quickSearchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:clickable="true"
        android:focusable="false"
        app:cardBackgroundColor="@color/glass_veil"
        app:cardForegroundColor="@android:color/transparent"
        app:rippleColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp">

        <!-- Genuinely symmetric now that the field is borderless: with the floating label off,
             TextInputLayout no longer reserves the band above its box that the old asymmetric pair
             was compensating for. The 4dp that was left over went entirely to the bottom, which is
             invisible once results are showing underneath but tipped the bare search bar — the
             state it is in every time it opens — noticeably high in its own card. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchLayout"
                style="@style/Widget.GestureLauncher.SearchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search_field">

                <!-- No textSize here on purpose: QuickSearchActivity sets it in density-independent
                     pixels so the field ignores the font-size multiplier BaseActivity applies to
                     every `sp` dimension. This is a fixed-height bar over someone else's app, not a
                     page of the launcher's own text — it has to stay the same shape whatever the
                     user's text size is, while the results below it still follow it. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Height ceiling is set in code from the space left above the keyboard; beyond it
                 the results scroll inside the card instead of growing it. Gone until there's
                 something to show, so the card stays a bare search bar. -->
            <!-- Hairline between the field and the results, in place of the box outline the
                 field used to draw around itself. -->
            <View
                android:id="@+id/cardDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/glass_divider"
                android:visibility="gone" />

            <dev.neffly.gesturelauncher.ui.MaxHeightRecyclerView
                android:id="@+id/resultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp"
                android:text="@string/quick_search_no_results"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</FrameLayout>
