<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <!-- Same 40dp box, same 20dp start inset, as item_app.xml's appIcon, so the letter's visual
         center lines up with the app icons' center instead of sitting flush against their left edge. -->
    <TextView
        android:id="@+id/headerLetter"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:background="@color/glass_divider" />

</LinearLayout>
