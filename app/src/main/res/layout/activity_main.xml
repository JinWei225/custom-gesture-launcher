<?xml version="1.0" encoding="utf-8"?>
<!-- Home: three pages side by side — widgets, the home page (clock, events, gesture canvas) and
     notes — under a dock that stays put across them. The pages are built from page_widgets,
     page_home and page_notes; see MainActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Kept outside the pager and the canvas so a recognizer crash can't remove it. Lock at the
         left corner, the page arrows in the middle, search at the right where the thumb already
         knows to find it. -->
    <FrameLayout
        android:id="@+id/homeDock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="36dp">

        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_drawer_button"
            android:contentDescription="@string/lock_screen"
            android:scaleType="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/wallpaper_overlay_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pageLeftButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_drawer_button"
                android:contentDescription="@string/page_left"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/wallpaper_overlay_text" />

            <ImageButton
                android:id="@+id/pageRightButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_drawer_button"
                android:contentDescription="@string/page_right"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/wallpaper_overlay_text" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_drawer_button"
            android:contentDescription="@string/open_search"
            android:scaleType="center"
            android:src="@drawable/ic_search"
            app:tint="@color/wallpaper_overlay_text" />
    </FrameLayout>

</FrameLayout>
