<?xml version="1.0" encoding="utf-8"?>
<!-- Home: three pages side by side — widgets, the home page (clock, events, gesture canvas) and
     notes — under a dock that belongs to the home page. The pages are built from page_widgets,
     page_home and page_notes; see MainActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Kept outside the pager and the canvas so a recognizer crash can't remove it. One search
         disc at whichever corner the user chose, and beside it a strip with nothing drawn in it:
         a drag there turns the pages and a double tap locks the screen (see DockStrip). Which
         corner, and so where the strip runs, is set in code from the setting; the bottom margin
         too, above whatever navigation bar the device has. The dock fades out on the side pages
         so it doesn't sit over the widgets and the note box. -->
    <FrameLayout
        android:id="@+id/homeDock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp">

        <View
            android:id="@+id/dockStrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/dock_strip" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_drawer_button"
            android:contentDescription="@string/open_search"
            android:scaleType="center"
            android:src="@drawable/ic_search"
            app:tint="@color/wallpaper_overlay_text" />
    </FrameLayout>

</FrameLayout>
