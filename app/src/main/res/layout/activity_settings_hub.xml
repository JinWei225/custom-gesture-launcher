<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_hub_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/section_launching"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <!-- Gestures or pie: which of the rows below apply follows from it (SettingsHubActivity). -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/launchStyleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/launch_style_title" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/pieAppsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/pie_apps_title" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/gesturesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/settings_title" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/sensitivityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/gesture_sensitivity_title"
                app:subtitle="@string/sensitivity_row_subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/section_backup"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/exportRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_export"
                app:subtitle="@string/export_row_subtitle" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/importRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_import"
                app:subtitle="@string/import_row_subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/section_general"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/autoKeyboardRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_auto_keyboard"
                app:subtitle="@string/auto_keyboard_row_subtitle"
                app:switchable="true" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/hapticFeedbackRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_haptic_feedback"
                app:subtitle="@string/haptic_feedback_row_subtitle"
                app:switchable="true" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/widgetsPageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/widgets_page"
                app:subtitle="@string/widgets_page_subtitle"
                app:switchable="true" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/notesPageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/notes_page"
                app:subtitle="@string/notes_page_subtitle"
                app:switchable="true" />

            <!-- Text is set in SettingsHubActivity.onResume: it names the chosen corner. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/searchSideRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_search_side" />

            <!-- Text is set in SettingsHubActivity.onResume, not here: it reflects the
                 current selection rather than a fixed description. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/themeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_theme" />

            <!-- Text is set in SettingsHubActivity.onResume: it's the chosen font's name,
                 not a fixed description. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/fontRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_font" />

            <!-- Text is set in SettingsHubActivity.onResume: it's the current multiplier. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/fontScaleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_font_size" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/tourReplayRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/tour_replay"
                app:subtitle="@string/tour_replay_subtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/section_search"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/quicklinksRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/quicklinks_title" />

            <!-- Text is set in SettingsHubActivity.onResume: the chosen engine's name. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/searchEngineRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_search_engine" />

            <!-- Shown only when Waze is installed: with Google Maps alone there is nothing to choose.
                 Its subtitle, the chosen app's name, is set from SettingsHubActivity. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/mapsAppRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:title="@string/menu_maps_app" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/voiceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/voice_search"
                app:subtitle="@string/voice_search_subtitle"
                app:switchable="true" />

            <!-- Greyed out from SettingsHubActivity.updateVoice while voice search is off, since
                 there is nothing for it to start. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/voiceOnAssistRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/voice_on_assist"
                app:subtitle="@string/voice_on_assist_subtitle"
                app:switchable="true" />

            <!-- Text is set in SettingsHubActivity: the words, or what the row is for. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/voiceWordsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/voice_words"
                app:subtitleMaxLines="1" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/quickSearchRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/menu_quick_search"
                app:subtitle="@string/quick_search_row_subtitle"
                app:switchable="true" />

            <!-- Enabled/disabled from SettingsHubActivity — the trigger is only meaningful while the
                 overlay above is switched on — and subtitled with whether the role is held. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/quickSearchTriggerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/quick_search_trigger" />

            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/defaultLauncherRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/change_default_launcher"
                app:subtitle="@string/change_default_launcher_row_subtitle" />

            <!-- Text is set in SettingsHubActivity.onResume: it reflects the current
                 exemption state, not a fixed description. -->
            <dev.neffly.gesturelauncher.ui.SettingsRow
                android:id="@+id/batteryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/keep_launcher_responsive" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/aboutRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
