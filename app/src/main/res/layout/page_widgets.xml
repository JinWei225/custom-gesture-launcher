<?xml version="1.0" encoding="utf-8"?>
<!-- The page left of home: widgets stacked downward, each an item_widget, with the add button
     at the end of the column. Drawn straight over the wallpaper like the home page. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/widgetColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- The column's last child, always: WidgetPage inserts widgets above it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addWidgetButton"
                style="@style/Widget.GestureLauncher.WallpaperPill"
                android:text="@string/add_widget"
                app:drawableStartCompat="@drawable/ic_add" />

            <!-- Edit shows the grips under the widgets; the same button reads Done while they
                 are showing. -->
            <TextView
                android:id="@+id/editWidgetsButton"
                style="@style/Widget.GestureLauncher.WallpaperPill"
                android:layout_marginStart="12dp"
                android:text="@string/widgets_edit"
                app:drawableStartCompat="@drawable/ic_edit" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
