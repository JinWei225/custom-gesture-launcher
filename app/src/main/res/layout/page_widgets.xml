<?xml version="1.0" encoding="utf-8"?>
<!-- The page left of home: widgets stacked downward, each an item_widget, under a menu glyph
     pinned to the top corner that holds "add" and "edit". Drawn straight over the wallpaper like
     the home page. The column's top padding keeps the first widget clear of the glyph, and its
     bottom padding keeps the last one clear of the dock. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/widgetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/widgetColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="64dp" />
    </androidx.core.widget.NestedScrollView>

    <dev.neffly.gesturelauncher.ui.ShadowImageView
        android:id="@+id/widgetMenuButton"
        style="@style/Widget.GestureLauncher.WallpaperGlyph"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/widgets_menu"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert" />

</FrameLayout>
