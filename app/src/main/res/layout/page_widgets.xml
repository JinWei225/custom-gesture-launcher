<?xml version="1.0" encoding="utf-8"?>
<!-- The page left of home: widgets stacked downward, each an item_widget, with the add button
     at the end of the column. Drawn straight over the wallpaper like the home page. The bottom
     padding keeps the last widget clear of the dock. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="112dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/widgetColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/addWidgetButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:drawablePadding="8dp"
            android:drawableTint="@color/wallpaper_overlay_text"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:text="@string/add_widget"
            android:textColor="@color/wallpaper_overlay_text"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_add" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
