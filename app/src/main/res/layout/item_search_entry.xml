<?xml version="1.0" encoding="utf-8"?>
<!-- Shared row for file, web, settings and calculator results. Deliberately reads the same
     minHeight, icon box and 20dp insets as item_app.xml, so a mixed result list has one row rhythm
     whichever theme supplies the numbers — see values/attrs.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="?attr/searchRowMinHeight"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <!-- The glyph is inset so it centres where an app icon's artwork sits, rather than filling
         the box edge to edge the way artwork does. -->
    <ImageView
        android:id="@+id/entryIcon"
        android:layout_width="?attr/searchRowIconSize"
        android:layout_height="?attr/searchRowIconSize"
        android:contentDescription="@null"
        android:padding="?attr/searchRowGlyphInset" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- ellipsize is set per row in AppListAdapter: START for file paths (the deepest folder
             is the useful end), END for the prose subtitles the other row types carry. -->
        <TextView
            android:id="@+id/entrySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
