<?xml version="1.0" encoding="utf-8"?>
<!-- Shared row for file and web results. Deliberately the same minHeight, 40dp icon box and 20dp
     insets as item_app.xml, so a mixed result list has one consistent row rhythm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <!-- 40dp box with padding so the 24dp glyph centres where an app icon's artwork sits. -->
    <ImageView
        android:id="@+id/entryIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <!-- ellipsize is set per row in AppListAdapter: START for file paths (the deepest folder
             is the useful end), END for the prose subtitles the other row types carry. -->
        <TextView
            android:id="@+id/entrySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
