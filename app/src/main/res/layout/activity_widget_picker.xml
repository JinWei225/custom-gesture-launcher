<?xml version="1.0" encoding="utf-8"?>
<!-- Glass like the widgets page it slides in over; the veil colour is set by ui/Glass.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/add_widget" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/providerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

</LinearLayout>
