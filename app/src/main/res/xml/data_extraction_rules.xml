<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup and device-to-device transfer, Android 12 and up. The same exclusions as
     backup_rules.xml, which explains them; keep the two in step. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="widgets.xml" />
        <exclude domain="sharedpref" path="crash_state.xml" />
        <exclude domain="file" path="app_list.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="widgets.xml" />
        <exclude domain="sharedpref" path="crash_state.xml" />
        <exclude domain="file" path="app_list.json" />
    </device-transfer>
</data-extraction-rules>
