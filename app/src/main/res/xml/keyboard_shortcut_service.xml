<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration for KeyboardShortcutService.

     Deliberately the smallest set of capabilities that still delivers key events.
     canRequestFilterKeyEvents + flagRequestFilterKeyEvents is the whole point; everything else is
     either required by the platform or turned off.

     accessibilityEventTypes cannot be empty — a service that subscribes to nothing is never bound
     — so it names the cheapest single type and the service ignores what arrives.
     canRetrieveWindowContent is absent, which is what stops this from being able to read the
     screen: the shortcut needs to know that a key was pressed, never what is on top of it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/keyboard_shortcut_service_description"
    android:notificationTimeout="100"
    android:summary="@string/keyboard_shortcut_service_summary" />
