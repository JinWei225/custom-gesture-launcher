<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration for LockDeviceAdmin. force-lock is the whole grant: it allows
     DevicePolicyManager.lockNow() and nothing else — no password rules, no wipe. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
