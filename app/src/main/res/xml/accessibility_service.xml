<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration for LauncherAccessibilityService.

     Deliberately the smallest set of capabilities that still delivers key events.
     canRequestFilterKeyEvents + flagRequestFilterKeyEvents is the whole point; everything else is
     either required by the platform or turned off. Locking the screen is a global action, which
     needs nothing declared here beyond the service being bound.

     accessibilityEventTypes cannot be empty — a service that subscribes to nothing is never bound
     — so it names the cheapest single type and the service ignores what arrives. packageNames then
     limits even that to this app's own windows: without it every window change on the device,
     from every app, was a binder call into this process to run an empty method. Key events are
     not filtered by package, so the shortcut still works everywhere.
     canRetrieveWindowContent is absent, which is what stops this from being able to read the
     screen: the shortcut needs to know that a key was pressed, never what is on top of it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="dev.neffly.gesturelauncher"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
