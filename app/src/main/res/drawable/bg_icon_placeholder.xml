<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in for an app icon that hasn't loaded yet (see AppListAdapter.bindIcon). Deliberately
     a flat, low-contrast shape rather than a glyph: it should read as "this row exists, its icon
     is coming", not as a real icon the user might try to recognise. Matters most on a cold start,
     where IconCache is empty and every visible row fetches from PackageManager as it binds.

     A rounded square of the same glass as the rest of the drawer — the shape the design uses for
     icon slots, and it no longer implies a circular icon the real one may not be. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="12dp" />
</shape>
