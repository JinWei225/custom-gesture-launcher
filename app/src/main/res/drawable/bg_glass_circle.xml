<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button inside a glass card: the same fill and hairline as the alias chip, so it
     reads as part of the card's frosted surface, with a ripple clipped to the disc. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</ripple>
