<?xml version="1.0" encoding="utf-8"?>
<!-- The dock button's dark glass, stretched into a pill: the note box and the add-widget button
     sit straight over the wallpaper like the discs do, so they take the same treatment. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wallpaper_glass_fill_dark" />
    <stroke
        android:width="1dp"
        android:color="@color/wallpaper_glass_stroke" />
    <corners android:radius="24dp" />
</shape>
