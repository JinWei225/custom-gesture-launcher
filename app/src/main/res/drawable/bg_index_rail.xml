<?xml version="1.0" encoding="utf-8"?>
<!-- Glass rail behind the drawer's A-Z index. Gives the letters a surface of their own so they
     stay legible over whatever wallpaper shows through the list beside them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="14dp" />
</shape>
