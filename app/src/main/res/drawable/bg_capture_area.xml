<?xml version="1.0" encoding="utf-8"?>
<!-- Backdrop for the gesture capture box on the training and sensitivity screens. The old
     grey-on-grey literals technically survived both themes, but the 4%-alpha fill was
     invisible against a light ground, leaving the box with no readable extent. Theme
     attributes give it a real surface step in both. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
</shape>
