<?xml version="1.0" encoding="utf-8"?>
<!-- A note's bubble: the dock's dark glass with a squared-off corner toward the box it was sent
     from, the way a sent message is drawn. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wallpaper_glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/wallpaper_glass_stroke" />
    <corners
        android:bottomLeftRadius="18dp"
        android:bottomRightRadius="6dp"
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
</shape>
