<?xml version="1.0" encoding="utf-8"?>
<!-- The guide pop-up's card (onboarding/TourBalloon). The dock's dark glass, but opaque: a hint can
     open over settings with nothing dimmed behind it, and the rows underneath must not read
     through the text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tour_card_fill" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/wallpaper_glass_stroke" />
</shape>
