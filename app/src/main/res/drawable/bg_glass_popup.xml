<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the app long-press menu, matching the drawer's and quick-search card's glass.

     The heavy veil ([glass_veil_flat]) rather than the light one ui/Glass.kt normally picks: a
     PopupMenu draws into a PopupWindow, and there is no public way to reach that window to ask for
     blur-behind. Without a blur the light veil would leave the menu's text sitting on sharp
     wallpaper or on the drawer rows underneath, so this takes the same "cover wins over effect"
     branch Glass.frost falls back to when the system refuses the blur.

     Corner radius sits between the card's 28dp and a list row's, and the hairline stroke is the
     same glass_stroke the card and the search field use. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_veil_flat" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
