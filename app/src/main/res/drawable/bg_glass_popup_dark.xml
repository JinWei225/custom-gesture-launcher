<?xml version="1.0" encoding="utf-8"?>
<!-- bg_glass_popup for a menu that opens over the wallpaper — the widget and note pages — where
     the dock's dark glass is the surface everything else already sits on. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wallpaper_glass_fill_dark" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/wallpaper_glass_stroke" />
</shape>
