    <string name="quick_search_row_subtitle">A floating search bar over any app, for switching apps and quick actions. Once it\'s on, hold the home screen\'s search button for the app list and Settings</string>
    <string name="quick_search_trigger">Quick search trigger</string>
    <string name="quick_search_trigger_granted">Ready — this launcher is your digital assistant. On Android 12+, also set Settings → System → Gestures → Press and hold power button to “Digital assistant”.</string>
