    <!-- The one accessibility service, shared by the keyboard shortcut and the double-tap lock. -->
    <string name="accessibility_service_label">Gessearch Launcher</string>
    <string name="accessibility_service_summary">Alt + Space opens quick search; a double tap on the home screen\'s dock locks the screen</string>
    <string name="accessibility_service_description">Lets Gessearch Launcher open its floating search bar when you press Alt + Space on a physical keyboard, and lock the screen when you double-tap the dock on its home screen.\n\nAndroid only lets an accessibility service see key presses from other apps or lock the screen, which is why this permission is needed. The service reads nothing on your screen.</string>

