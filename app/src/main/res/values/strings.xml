    <!-- Keyboard shortcut (accessibility service). The description is what the system shows on
         the service's own page in the accessibility settings, so it has to explain the access in
         the user's terms rather than ours. -->
    <string name="keyboard_shortcut">Keyboard shortcut</string>
    <string name="keyboard_shortcut_row_subtitle">Press Alt + Space on a physical keyboard to open quick search</string>
    <string name="keyboard_shortcut_access">Keyboard access</string>
    <string name="keyboard_shortcut_access_granted">Ready — Alt + Space works anywhere. Tap to review or turn the access off.</string>
    <string name="keyboard_shortcut_access_missing">Needs accessibility access — tap to see what it allows. Without it Android won\'t deliver key presses from other apps.</string>

    <!-- The accessibility service, used only by the keyboard shortcut. -->
    <string name="accessibility_service_label">Gessearch Launcher</string>
    <string name="accessibility_service_summary">Alt + Space opens quick search</string>
    <string name="accessibility_service_description">Lets Gessearch Launcher open its floating search bar when you press Alt + Space on a physical keyboard.\n\nAndroid only lets an accessibility service see key presses from other apps, which is why this permission is needed. The service reads nothing on your screen.</string>

    <!-- The home screen dock: search at one corner, the strip beside it. -->
    <string name="dock_strip">Swipe to turn the page, touch and hold to speak</string>
    <string name="menu_search_side">Search button</string>
    <string name="search_side_left">Left corner</string>
    <string name="search_side_right">Right corner</string>
    <!-- The prominent disclosure Google Play requires before the user is sent to grant the access:
         what the service receives, what it does with it, and what it doesn't. Shown by both the
         keyboard row. -->
    <string name="accessibility_disclosure_title">Allow accessibility access?</string>
    <string name="accessibility_disclosure_message">Gessearch Launcher uses Android\'s accessibility service for one feature, because Android offers no other way to do it: Alt + Space on a physical keyboard opens quick search from any app.\n\nThe service receives the keys you press on a physical keyboard, acts only on Alt + Space, and passes every other key straight on. It does not read what is on your screen, and it does not store or share your key presses — this app has no internet access.\n\nIf you agree, turn on “Gessearch Launcher” on the next screen. You can turn it off there at any time.</string>
    <string name="accessibility_disclosure_agree">Agree</string>
    <string name="accessibility_disclosure_decline">No thanks</string>

