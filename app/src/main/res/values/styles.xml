<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.GestureLauncher.WallpaperGlyph" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_widget_tap</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">9dp</item>
        <item name="tint">@color/wallpaper_overlay_text</item>
    </style>

    <!-- Window animations for GlassMenu's popup, below its anchor and above it. -->
    <style name="Animation.GestureLauncher.GlassMenu" parent="">
        <item name="android:windowEnterAnimation">@anim/glass_menu_in</item>
        <item name="android:windowExitAnimation">@anim/glass_menu_out</item>
    </style>

    <style name="Animation.GestureLauncher.GlassMenu.Up">
        <item name="android:windowEnterAnimation">@anim/glass_menu_in_up</item>
    </style>
</resources>
