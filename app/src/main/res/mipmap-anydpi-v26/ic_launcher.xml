<?xml version="1.0" encoding="utf-8"?>
<!-- Layers are rendered from icon.png at the repo root, spanning 88dp of the 108dp canvas so the
     magnifier clears every launcher mask. The monochrome layer is the same artwork thresholded
     to its solid pixels, which is what themed icons tint. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
